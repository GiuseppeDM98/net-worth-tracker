# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
# Alternate build dirs: `next dev` refuses a second server for the same dist dir, so the
# Playwright suite (.next-e2e) and any throwaway verification server pass their own via
# NEXT_DIST_DIR. Ignored as a family, or every such run shows up as untracked build output.
/.next-*/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# Firebase Admin SDK service account keys
firebase-admin-key.json

# Firebase local emulator (persisted data exports + debug logs)
/.emulator-data
# Staging dir the CLI writes export-on-exit into before moving it to .emulator-data —
# left behind, and possibly half-written, whenever the emulator is killed by a signal.
/firebase-export-*
firebase-debug.log
firestore-debug.log
database-debug.log
ui-debug.log
pubsub-debug.log

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Draft\ Release\ Temp.md

# Impeccable: critiques are run-specific, design.json is a committed design artifact
.impeccable/critique/

# Local tool directories (Claude Code, Antigravity CLI)
.agents/
.antigravitycli/
skills-lock.json

# Editor
.vscode/

# Playwright
/test-results/
/playwright-report/
/e2e/.auth/
